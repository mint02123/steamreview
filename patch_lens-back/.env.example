# 백엔드 환경변수 예시. 이 파일을 복사해 .env 를 만들고 실제 값을 채운다.
#   cp .env.example .env
# 실제 .env 는 절대 커밋하지 않는다(.gitignore 처리됨).

# Anthropic API 키 (콘솔에서 발급, 절대 공개 금지)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5

# PostgreSQL 접속 URL
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# JWT 설정 (배포 시 길고 무작위한 값으로 교체)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 전체 수집 리뷰 수 (Overview KPI 표시용)
SOURCE_TOTAL_REVIEWS=227120

# CORS 허용 오리진 (쉼표로 구분). 배포 시 프론트 도메인 추가
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
